{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "bun-types",
      "bun-types/test-globals"
    ]
  },
  "include": [
    "src",
    "tests",
    "viewer",
    "referee",
    "practice",
    "workspace",
    "vite.config.ts",
    "vite.referee.config.ts",
    "vite.practice.config.ts",
    "vite.workspace.config.ts"
  ]
}