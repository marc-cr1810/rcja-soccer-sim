{
  "name": "rcja-soccer-sim",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Match server and simulator for the RCJA Soccer Simulation league",
  "license": "Apache-2.0",
  "bin": {
    "rcja-soccer-sim": "./bin/rcja-soccer-sim.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "serve": "tsx src/cli.ts",
    "build:viewer": "vite build",
    "dev:viewer": "vite",
    "build:referee": "vite build --config vite.referee.config.ts",
    "build:practice": "vite build --config vite.practice.config.ts",
    "build:workspace": "vite build --config vite.workspace.config.ts",
    "dev:referee": "vite --config vite.referee.config.ts",
    "dev:practice": "vite --config vite.practice.config.ts",
    "dev:workspace": "vite --config vite.workspace.config.ts",
    "bench": "tsx src/cli.ts bench"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "codemirror": "^6.0.2",
    "three": "^0.169.0",
    "ws": "^8.18.0"
  }
}
