# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.venv/
env/
venv/
ENV/

# ─── Build & Distribution Outputs ─────────────────────────────────────────────
dist/
dist-*/
bin/rcja-soccer-sim
!bin/rcja-soccer-sim.js
*.tsbuildinfo

# ─── Logs & Diagnostics ───────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-report.txt

# ─── Python Caches & Environments ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ─── Runtime State & Databases ────────────────────────────────────────────────
# Runtime state a server accumulates in whatever directory it is run from:
# pushed submissions, teams' working folders, tournaments, and accounts database.
data/
submissions/
workspaces/
tournaments/
league/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sock

# ─── Probe Output & Temporary Scratch Files ───────────────────────────────────
# Trace logs, recorded sensor frames, and local credentials
scratch/*.jsonl
scratch/frames/
scratch/rotframes/
scratch/locframes.json
teams.local.json
*.local.json
.env
.env.*
!.env.example

# ─── Editor & OS Metadata ─────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
.idea/
*.sublime-workspace
*.sublime-project
